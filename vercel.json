{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/catalog-data.js": { "includeFiles": "data/studielots-db/**" },
    "api/program-index.js": { "includeFiles": "data/studielots-db/**" }
  },
  "rewrites": [
    { "source": "/api/canonical-offerings", "destination": "/api/catalog-data?route=canonical-offerings" },
    { "source": "/api/credit-transfer-history", "destination": "/api/catalog-data?route=credit-transfer-history" }
  ],
  "headers": [
    { "source": "/src/styles/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/src/pages/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/src/core/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/src/features/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/src/ui/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/src/bootstrap.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
